opam-version: "2.0"
maintainer: "rvantonder@gmail.com"
authors: "Rijnard van Tonder"
license: "Apache-2.0"
build: [
  ["dune" "build" "-j" jobs "@install"]
]
depends: [
  "ocaml" {>= "5.0.0"}
  "dune" {>= "3.0.0"}
  "core_kernel"
  "mparser" {>= "1.3"}
  "ppx_deriving"
  "ppx_deriving_yojson" {>= "3.6.0"}
  "ppx_here"
  "ppx_sexp_conv"
  "ppx_sexp_message"
  "yojson"
  "re"
  "bigstringaf"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
]
synopsis: "Lite JavaScript build of the Comby kernel"
